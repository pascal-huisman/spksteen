# Kopieer dit bestand naar .env en vul de waarden in:
#   cp .env.example .env

# ── aims_notify ────────────────────────────────────────────────
# URL van jouw aims_notify container (container naam of intern IP)
NOTIFY_URL=http://aims_notify/notify

# API key zoals ingesteld in je aims_notify configuratie
NOTIFY_API_KEY=jouw-api-key-hier

# Template naam in aims_notify (standaard: speksteen_contact)
# Maak dit template aan in aims_notify met de variabelen:
#   {{naam}}, {{email}}, {{onderwerp}}, {{bericht}}, {{datum}}, {{ip}}
NOTIFY_TEMPLATE=speksteen_contact
